# ═══════════════════════════════════════════════════════════════════════════════
# Variables d'environnement — EducNet sur Vercel
# Copier ces clés dans : Vercel Dashboard → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=remplacer-par-une-chaine-aleatoire-longue-et-secrete
DJANGO_DEBUG=False
# URL publique de votre app Vercel (ex: https://educnet.vercel.app)
# Nécessaire pour ALLOWED_HOSTS et CSRF_TRUSTED_ORIGINS
DJANGO_SITE_URL=https://votre-projet.vercel.app

# ─── Base de données Neon (PostgreSQL) ─────────────────────────────────────────
# Obtenir depuis : console.neon.tech → votre projet → Connection string
# Format :  postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Cloudflare R2 (stockage médias) ───────────────────────────────────────────
# Obtenir depuis : Cloudflare Dashboard → R2 → votre bucket → Manage R2 API tokens
#
# R2_ENDPOINT_URL  → https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_URL    → URL publique du bucket (activer "Public Access" dans R2)
#                    ex. https://media.educnet.app  ou  https://pub-xxxx.r2.dev

R2_ACCESS_KEY_ID=votre-r2-access-key-id
R2_SECRET_ACCESS_KEY=votre-r2-secret-access-key
R2_BUCKET_NAME=educnet-media
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.educnet.app

# ─── (Optionnel) Cloudinary — alternative à R2 ────────────────────────────────
# Si R2_ACCESS_KEY_ID n'est PAS défini, l'app bascule sur Cloudinary si cette
# variable est présente. Laisser vide si vous utilisez R2.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─── (Optionnel) Email SMTP ────────────────────────────────────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=votre@email.com
# EMAIL_HOST_PASSWORD=votre-mot-de-passe-app
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=EducNet <no-reply@educnet.app>
