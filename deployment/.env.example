# ═══════════════════════════════════════════════════════════════════════════════
# Variables d'environnement — EducNet sur Vercel
# Copier ces clés dans : Vercel Dashboard → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=remplacer-par-une-chaine-aleatoire-longue-et-secrete
DJANGO_DEBUG=False
# URL publique de votre app Vercel (ex: https://educnet.vercel.app)
DJANGO_SITE_URL=https://votre-projet.vercel.app

# ─── Base de données Neon (PostgreSQL) ─────────────────────────────────────────
# Obtenir depuis : console.neon.tech → votre projet → Connection string (psycopg2)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Cloudinary (stockage médias — recommandé) ─────────────────────────────────
# Obtenir depuis : cloudinary.com → Dashboard → "API Environment variable"
# Format : cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://123456789012345:AbCdEfGhIjKlMnOpQrStUvWxYz@mon-cloud

# ─── (Optionnel) Cloudflare R2 — alternative à Cloudinary ─────────────────────
# Décommenter UNIQUEMENT si vous n'utilisez pas Cloudinary.
# Si CLOUDINARY_URL est défini, R2 est ignoré automatiquement.
# R2_ACCESS_KEY_ID=votre-r2-access-key-id
# R2_SECRET_ACCESS_KEY=votre-r2-secret-access-key
# R2_BUCKET_NAME=educnet-media
# R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ─── (Optionnel) Email SMTP ────────────────────────────────────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=votre@email.com
# EMAIL_HOST_PASSWORD=votre-mot-de-passe-app
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=EducNet <no-reply@educnet.app>
