# Exemple de variables d'environnement pour le projet
# Copiez ce fichier en .env puis remplacez les valeurs par les vôtres.

DJANGO_SECRET_KEY=changez-cette-cle-en-production-minimum-50-caracteres
DJANGO_DEBUG=False
DJANGO_SITE_URL=https://<votre-compte>.pythonanywhere.com

# Utilisez Neon / PostgreSQL
DATABASE_URL=postgres://user:password@host:5432/dbname
DB_SSLMODE=require

# Optionnel : SMTP pour l'envoi d'e-mails
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@example.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_smtp
DEFAULT_FROM_EMAIL=noreply@votre-domaine.com
