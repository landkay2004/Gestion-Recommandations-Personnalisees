{
  "version": 2,
  "buildCommand": "bash deployment/build_files.sh",
  "functions": {
    "deployment/vercel_wsgi.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "school_app/**"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/school_app/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "deployment/vercel_wsgi.py"
    }
  ]
}
